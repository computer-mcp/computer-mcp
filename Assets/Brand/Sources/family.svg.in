<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="640" viewBox="0 0 1280 640">
  <title>{{name}} — {{integration}}</title>
  <rect width="1280" height="640" fill="{{graphite}}"/>
  <g transform="translate(68 51) scale(.38)">{{symbol}}</g>
  <g font-family="Helvetica Neue, Helvetica, Arial, sans-serif" fill="{{silver}}">
    <text x="184" y="119" font-size="26" fill="{{muted}}">First-party plugin</text>
    <text x="80" y="315" font-size="80" font-weight="600" letter-spacing="-1.5">{{name}}</text>
    <text x="80" y="402" font-size="48" font-weight="500">{{integration}}</text>
    <path d="M80 490H1200" stroke="{{line}}"/>
    <text x="80" y="554" font-size="22" fill="{{muted}}">{{role}}</text>
  </g>
</svg>
