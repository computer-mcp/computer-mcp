<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="640" viewBox="0 0 1280 640">
  <title>{{name}} — {{headline_label}}</title>
  <rect width="1280" height="640" fill="{{graphite}}"/>
  <g transform="translate(68 51) scale(.38)">{{symbol}}</g>
  <g font-family="Helvetica Neue, Helvetica, Arial, PingFang SC, sans-serif" fill="{{silver}}">
    <text x="184" y="119" font-size="38" font-weight="500">{{name}}</text>
    <text x="80" y="315" font-size="{{headline_size}}" font-weight="600" letter-spacing="-1.5">{{line1}}</text>
    <text x="80" y="408" font-size="{{headline_size}}" font-weight="600" letter-spacing="-1.5">{{line2}}</text>
    <text x="80" y="554" font-size="22" fill="{{muted}}">{{footer}}</text>
  </g>
</svg>
