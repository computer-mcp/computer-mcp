{
  "description": "Target layers, permitted same-layer dependencies, platform boundaries and test support targets. See Documentation/Decisions/ModuleArchitecture.md.",
  "layers": [
    {
      "name": "base",
      "targets": [
        "ComputerMCPCore",
        "ComputerMCPSandbox"
      ]
    },
    {
      "name": "platform",
      "targets": [
        "ComputerMCPPlatform",
        "ComputerMCPPlatformPOSIX",
        "CSystemArchive",
        "CDarwinExecution",
        "ComputerMCPPlatformDarwin",
        "computer-mcp-execution-bootstrap"
      ]
    },
    {
      "name": "services",
      "targets": [
        "ComputerMCPEgress",
        "ComputerMCPConfiguration",
        "ComputerMCPPersistence",
        "ComputerMCPProcess",
        "ComputerMCPTransport",
        "ComputerMCPDownstream",
        "ComputerMCPTunnels"
      ]
    },
    {
      "name": "capabilities",
      "targets": [
        "ComputerMCPToolKit",
        "ComputerMCPToolsMCP",
        "ComputerMCPToolsCLI",
        "ComputerMCPToolsFiles",
        "ComputerMCPToolsProject",
        "ComputerMCPToolsStructured",
        "ComputerMCPToolsGit",
        "ComputerMCPToolsShell",
        "ComputerMCPToolsSkills",
        "ComputerMCPToolsSystem",
        "ComputerMCPDelivery",
        "ComputerMCPAuthorization",
        "ComputerMCPPlugins",
        "ComputerMCPComputerUse"
      ]
    },
    {
      "name": "composition",
      "targets": [
        "ComputerMCPGateway",
        "ComputerMCPControlPlane"
      ]
    },
    {
      "name": "composition-root",
      "targets": [
        "ComputerMCPMacOS"
      ]
    },
    {
      "name": "front-ends",
      "targets": [
        "ComputerMCPApp",
        "ComputerMCPExecutionProbe",
        "computer-mcp"
      ]
    }
  ],
  "allow": [
    "ComputerMCPPlatformPOSIX->ComputerMCPPlatform",
    "ComputerMCPPlatformDarwin->ComputerMCPPlatform",
    "ComputerMCPPlatformDarwin->ComputerMCPPlatformPOSIX",
    "ComputerMCPPlatformDarwin->CSystemArchive",
    "ComputerMCPPlatformDarwin->CDarwinExecution",
    "ComputerMCPProcess->ComputerMCPConfiguration",
    "ComputerMCPTransport->ComputerMCPConfiguration",
    "ComputerMCPDownstream->ComputerMCPConfiguration",
    "ComputerMCPDownstream->ComputerMCPProcess",
    "ComputerMCPDownstream->ComputerMCPTransport",
    "ComputerMCPTunnels->ComputerMCPConfiguration",
    "ComputerMCPTunnels->ComputerMCPProcess",
    "ComputerMCPToolsMCP->ComputerMCPToolKit",
    "ComputerMCPToolsCLI->ComputerMCPToolKit",
    "ComputerMCPToolsFiles->ComputerMCPToolKit",
    "ComputerMCPToolsProject->ComputerMCPToolKit",
    "ComputerMCPToolsStructured->ComputerMCPToolKit",
    "ComputerMCPToolsGit->ComputerMCPToolKit",
    "ComputerMCPDelivery->ComputerMCPToolKit",
    "ComputerMCPToolsShell->ComputerMCPToolKit",
    "ComputerMCPToolsSkills->ComputerMCPToolKit",
    "ComputerMCPToolsSystem->ComputerMCPToolKit",
    "ComputerMCPToolsProject->ComputerMCPToolsFiles",
    "ComputerMCPToolsStructured->ComputerMCPToolsFiles",
    "ComputerMCPToolsSkills->ComputerMCPToolsFiles",
    "ComputerMCPToolsSkills->ComputerMCPToolsStructured",
    "ComputerMCPToolsSystem->ComputerMCPToolsFiles",
    "ComputerMCPPlugins->ComputerMCPToolsCLI",
    "ComputerMCPControlPlane->ComputerMCPGateway"
  ],
  "macos_only": [
    "ComputerMCPExecutionProbe",
    "CSystemArchive",
    "CDarwinExecution",
    "ComputerMCPPlatformDarwin",
    "ComputerMCPComputerUse",
    "ComputerMCPComputerUseTests",
    "ComputerMCPMacOS",
    "ComputerMCPApp",
    "computer-mcp",
    "ComputerMCPToolsStructuredDarwinTests",
    "ComputerMCPToolsFilesDarwinTests",
    "ComputerMCPToolsProjectDarwinTests",
    "ComputerMCPToolsSystemDarwinTests",
    "ComputerMCPPluginsDarwinTests",
    "ComputerMCPMacOSTests",
    "ComputerMCPGatewayDarwinTests",
    "ComputerMCPControlPlaneDarwinTests",
    "computer-mcp-execution-bootstrap"
  ],
  "macos_imports": [
    "AVFoundation",
    "AppKit",
    "ApplicationServices",
    "CSystemArchive",
    "CDarwinExecution",
    "Cocoa",
    "Combine",
    "CoreFoundation",
    "CoreGraphics",
    "CoreServices",
    "CryptoKit",
    "Darwin",
    "IOKit",
    "ImageIO",
    "LocalAuthentication",
    "Network",
    "OSLog",
    "PDFKit",
    "QuartzCore",
    "ScreenCaptureKit",
    "Security",
    "ServiceManagement",
    "SwiftUI",
    "SystemConfiguration",
    "UniformTypeIdentifiers",
    "os"
  ],
  "conditional_macos_imports": [
    "Darwin"
  ],
  "macos_path_prefixes": [
    "/Applications/",
    "/System/",
    "/usr/bin/",
    "/usr/sbin/"
  ],
  "posix_paths": [
    "/usr/bin/env"
  ],
  "test_support": [
    "ComputerMCPTestSupport"
  ]
}
