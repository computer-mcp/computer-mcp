    "storage.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logical release removes recovery records without immediately freeing disk space. Run reclamation when you want to reclaim storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逻辑释放仅移除恢复记录，不会立即腾出磁盘空间。需要时请单独执行存储空间回收。"
          }
        }
      }
    },
    "storage.dialog.reclaim.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
