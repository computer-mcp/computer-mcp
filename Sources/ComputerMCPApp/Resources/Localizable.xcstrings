    "Revision" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Revision"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修订号"}}}},
    "Checked at" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checked at"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查时间"}}}},
