    "%@'s settings changed after you reviewed them. Nothing was changed; review again." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@'s settings changed after you reviewed them. Nothing was changed; review again."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 的设置在您检查后发生了变化。未做任何更改，请重新检查。"}}}},
