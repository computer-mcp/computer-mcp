    "The permission store is older than the authority already used, for example after a restore from a backup. Review the permissions below, then confirm them to resume." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The permission store is older than the authority already used, for example after a restore from a backup. Review the permissions below, then confirm them to resume."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "权限存储比已经使用过的授权更旧，例如从备份恢复之后。请检查下面的权限，确认后恢复使用。"}}}},
    "Confirm Permissions" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Confirm Permissions"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "确认权限"}}}},
    "Requests" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Requests"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请求"}}}},
