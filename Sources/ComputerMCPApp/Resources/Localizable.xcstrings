    "Cloudflare Tunnel Logs" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Tunnel Logs" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare 隧道日志" } } } },
    "Computer MCP Access Token created" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP Access Token created" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已创建 Computer MCP 访问令牌" } } } },
    "Computer MCP: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP：%@" } } } },
    "Connected %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接于 %@" } } } },
    "Copy this once into the external consumer. Computer MCP stores it only in Keychain." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy this once into the external consumer. Computer MCP stores it only in Keychain." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请一次性复制到外部消费者。Computer MCP 只会将它存储在钥匙串中。" } } } },
    "Delete" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "Delete %@?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete %@?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除“%@”？" } } } },
    "Enable Full Shell" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Full Shell" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用完整命令行环境" } } } },
    "Enable Full Shell?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Full Shell?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用完整命令行环境？" } } } },
    "Full Shell gives authorized callers the current macOS user's effective file, process, network, and credential access. Workspace grants are not a containment boundary while it is enabled." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Full Shell gives authorized callers the current macOS user's effective file, process, network, and credential access. Workspace grants are not a containment boundary while it is enabled." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完整命令行环境会让获准调用者获得当前 macOS 用户的实际文件、进程、网络和凭据访问能力。启用后，工作区授权不构成隔离边界。" } } } },
    "Gateway Manifest" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Gateway Manifest" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关清单" } } } },
    "Input %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Input %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入摘要 %@" } } } },
    "Leave blank to follow the macOS HTTPS or HTTP proxy. Credentials are not allowed." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave blank to follow the macOS HTTPS or HTTP proxy. Credentials are not allowed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空以跟随 macOS 的 HTTPS 或 HTTP 代理。不允许包含凭据。" } } } },
    "Leave blank to use the configured provider or PATH." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave blank to use the configured provider or PATH." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空以使用已配置的提供方或 PATH。" } } } },
    "Leave the API key blank to keep the existing Keychain value." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave the API key blank to keep the existing Keychain value." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API 密钥留空即可保留钥匙串中的现有值。" } } } },
    "Loopback origin 127.0.0.1:%@ · metrics 127.0.0.1:%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loopback origin 127.0.0.1:%@ · metrics 127.0.0.1:%@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地回环源 127.0.0.1:%@ · 指标 127.0.0.1:%@" } } } },
    "No API keys, tunnel tokens, or TOML paths are included." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No API keys, tunnel tokens, or TOML paths are included." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其中不包含 API 密钥、隧道令牌或 TOML 路径。" } } } },
    "No diagnostic checks were returned." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No diagnostic checks were returned." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未返回诊断检查结果。" } } } },
    "OpenAI" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OpenAI" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OpenAI" } } } },
