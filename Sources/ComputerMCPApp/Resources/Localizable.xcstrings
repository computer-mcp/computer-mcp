    "For trusted stdio adapters only. Calls retain this connection's workspace and grants; local approval authority is not delegated.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For trusted stdio adapters only. Calls retain this connection's workspace and grants; local approval authority is not delegated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于可信的标准输入输出适配器。调用沿用当前连接的工作区和授权，不会获得本机审批权。"
          }
        }
      }
    },
    "Override process arguments" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Override process arguments"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义启动参数"}}}},
