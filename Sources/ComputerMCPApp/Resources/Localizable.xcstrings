    "Connected clients" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected clients"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已连接的客户端"}}}},
    "Clients appear here when they connect." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clients appear here when they connect."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"客户端连接后会显示在此处。"}}}},
    "Saved client approvals" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved client approvals"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存的客户端授权"}}}},
    "New connections can restore Full Access only while the approved permissions remain unchanged. Revoke to require your approval again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"New connections can restore Full Access only while the approved permissions remain unchanged. Revoke to require your approval again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅当已批准的权限保持不变时，新连接才能恢复完全访问权限。撤销后需要再次由您批准。"}}}},
    "Revoke" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Revoke"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"撤销"}}}},
    "Checking client access…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking client access…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查客户端权限…"}}}},
    "Connection %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接 %@"}}}},
    "This Session" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Session"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅此会话"}}}},
    "Always Allow this Client" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always Allow this Client"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"始终允许此客户端"}}}},
    "Observe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Observe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观察"}}}},
    "End access" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"End access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结束访问"}}}},
    "Access ended" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Access ended"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"访问已结束"}}}},
    "Access unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Access unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"权限不可用"}}}},
    "Allow Full Access?" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Full Access?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许完全访问？"}}}},
    "This client can run commands and access files, processes, the network, and credentials available to your macOS user. A project does not limit this access. macOS privacy permissions still apply." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This client can run commands and access files, processes, the network, and credentials available to your macOS user. A project does not limit this access. macOS privacy permissions still apply."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此客户端可以运行命令，并访问您的 macOS 用户可访问的文件、进程、网络和凭据。项目不会限制此权限范围，macOS 隐私权限仍然有效。"}}}},
    "Allow for" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow for"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"授权期限"}}}},
    "Clients sharing the same connection credential share a trusted identity. Ending this session does not revoke an always-allowed client." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clients sharing the same connection credential share a trusted identity. Ending this session does not revoke an always-allowed client."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用同一连接凭据的客户端共享可信身份。结束此会话不会撤销“始终允许”的客户端授权。"}}}},
    "Client access changed. Close this window and review the connection again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Client access changed. Close this window and review the connection again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"客户端权限已变化，请关闭此窗口并重新查看连接。"}}}},
    "Allow Full Access" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Full Access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许完全访问"}}}},
    "Connection defaults" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection defaults"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接默认设置"}}}},
    "Search published official plugins. Results are filtered for this Mac." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search published official plugins. Results are filtered for this Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索已发布的官方插件，结果按这台 Mac 的兼容性筛选。"}}}},
    "Searching official catalog" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Searching official catalog"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在搜索官方目录"}}}},
    "Catalog page %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Catalog page %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目录第 %@ 页"}}}},
    "Loaded from official catalog" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loaded from official catalog"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已从官方目录读取"}}}},
    "Some catalog data is unavailable. Review the details below." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some catalog data is unavailable. Review the details below."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分目录数据不可用，请查看下方详情。"}}}},
    "No matching plugins." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No matching plugins."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有匹配的插件。"}}}},
    "Catalog issues" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Catalog issues"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目录问题"}}}},
    "Refresh catalog" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh catalog"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新目录"}}}},
    "Search, filters and pages use the cached catalog." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search, filters and pages use the cached catalog."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索、筛选和翻页使用本地缓存目录。"}}}},
    "Catalog could not be refreshed. Showing saved results." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Catalog could not be refreshed. Showing saved results."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目录刷新失败，正在显示已保存的结果。"}}}},
    "Catalog generation %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Catalog generation %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目录版本 %@"}}}},
    "Published %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Published %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布于 %@"}}}},
    "Release" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Release"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布版本"}}}},
    "Prerequisites" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prerequisites"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"运行前提"}}}},
    "Latest compatible stable release" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest compatible stable release"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最新兼容的稳定版本"}}}},
    "The plugin catalog is busy. Try again shortly." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin catalog is busy. Try again shortly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件目录正忙，请稍后重试。"}}}},
    "The plugin publisher returned an invalid catalog response." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin publisher returned an invalid catalog response."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件发布方返回的目录响应无效。"}}}},
    "The plugin publisher, repository, release or catalog revision does not match the verified source." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin publisher, repository, release or catalog revision does not match the verified source."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件发布方、仓库、发布版本或目录版本与已核验的来源不一致。"}}}},
    "The plugin publisher requested authentication. Public plugin requests do not use host credentials." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin publisher requested authentication. Public plugin requests do not use host credentials."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件发布方要求身份验证；公开插件请求不会使用宿主凭据。"}}}},
    "Plugin request failed with HTTP %@." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin request failed with HTTP %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件请求失败，HTTP 状态码为 %@。"}}}},
    "The plugin publisher has limited requests. Wait before trying again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin publisher has limited requests. Wait before trying again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件发布方限制了请求，请稍后重试。"}}}},
    "The plugin request timed out. Check the connection and try again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin request timed out. Check the connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件请求超时，请检查网络连接后重试。"}}}},
    "The plugin publisher is unavailable. Check the connection and try again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin publisher is unavailable. Check the connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件发布方暂时不可用，请检查网络连接后重试。"}}}},
    "The official catalog could not be refreshed. Previously verified discovery data is shown." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The official catalog could not be refreshed. Previously verified discovery data is shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方目录刷新失败，正在显示此前核验的目录数据。"}}}},
    "The catalog cache could not be read or saved. Current results remain available in this process." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The catalog cache could not be read or saved. Current results remain available in this process."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取或保存目录缓存；当前结果在本次运行中仍可使用。"}}}},
    "Repair %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repair %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修复 %@"}}}},
    "Repair Project" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repair Project"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修复项目"}}}},
    "Use Folder" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Folder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用文件夹"}}}},
    "Repair…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repair…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修复…"}}}},
    "Unable to repair project" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to repair project"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法修复项目"}}}},
    "Choose the folder for %@. Existing project permissions will apply to this folder." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the folder for %@. Existing project permissions will apply to this folder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为 %@ 选择文件夹。现有项目权限将适用于此文件夹。"}}}},
    "Profile" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"权限方案"}}}},
    "Permissions for selected tools, projects, and connections" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permissions for selected tools, projects, and connections"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置工具、项目和连接的权限"}}}},
    "Caller" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caller"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调用渠道"}}}},
    "Client" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Client"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"客户端"}}}},
    "Deny" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deny"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拒绝"}}}},
    "Approved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已批准"}}}},
    "Expired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expired"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已过期"}}}},
    "Recover released record" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recover released record"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复已释放记录"}}}},
    "Recovery requires released process locks and confirmed host authorization cleanup. Damaged or unconfirmed records remain blocked." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery requires released process locks and confirmed host authorization cleanup. Damaged or unconfirmed records remain blocked."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复要求进程锁已释放，并且宿主授权清理已确认。损坏或未确认的记录仍会阻止启动。"}}}},
    "Process record recovered. Check the connection again when ready; no process was started." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Process record recovered. Check the connection again when ready; no process was started."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进程记录已恢复。准备好后可再次检查连接；本次未启动进程。"}}}},
    "Only this reviewed record will be retired. No process or downstream action will be started." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only this reviewed record will be retired. No process or downstream action will be started."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅清理这条已查看的记录，不会启动进程或执行下游操作。"}}}},
    "Previous MCP cleanup is unconfirmed. Review the process records before starting another connection." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Previous MCP cleanup is unconfirmed. Review the process records before starting another connection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"之前的 MCP 清理尚未确认。请先查看进程记录，再启动连接。"}}}},
    "Host session is active" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host session is active"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"宿主会话活跃"}}}},
    "Process has stopped" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Process has stopped"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进程已停止"}}}},
    "Waiting for process cleanup" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for process cleanup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待进程清理"}}}},
    "Process cleanup needs recovery" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Process cleanup needs recovery"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进程清理需要恢复"}}}},
    "Host authorization cleanup is unconfirmed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host authorization cleanup is unconfirmed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"宿主授权清理尚未确认"}}}},
    "Process record is damaged" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Process record is damaged"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进程记录已损坏"}}}},
    "HTTP bearer authentication" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"HTTP bearer authentication"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"HTTP Bearer 认证"}}}},
    "Credential endpoint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential endpoint"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据绑定地址"}}}},
    "Keychain account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keychain account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"钥匙串账户"}}}},
    "HTTP only. Bind the exact server URL and save these settings, then use Manage credential to store the token. An endpoint change requires a new binding; redirects are rejected." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"HTTP only. Bind the exact server URL and save these settings, then use Manage credential to store the token. An endpoint change requires a new binding; redirects are rejected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅适用于 HTTP。绑定完整服务器地址并保存设置，再通过“管理凭据”保存令牌。地址变更需要重新绑定；不接受重定向。"}}}},
    "Manage credential" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage credential"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理凭据"}}}},
    "Credential is stored." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential is stored."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已保存。"}}}},
    "Credential is missing." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential is missing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缺少凭据。"}}}},
    "Bearer token" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bearer token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Bearer 令牌"}}}},
    "The token is stored only in the host Keychain. New requests read the current value; changing it does not cancel already issued requests." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The token is stored only in the host Keychain. New requests read the current value; changing it does not cancel already issued requests."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"令牌仅保存在宿主钥匙串中。新请求读取当前值；更改凭据不会取消已发出的请求。"}}}},
    "Remove credential" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove credential"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除凭据"}}}},
    "MCP credentials require an exact endpoint binding using HTTPS or loopback HTTP, and a valid Keychain account." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MCP credentials require an exact endpoint binding using HTTPS or loopback HTTP, and a valid Keychain account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 凭据必须绑定完整的 HTTPS 或本机回环 HTTP 地址，并使用有效的钥匙串账户。"}}}},
    "The host cannot access the MCP credential. Check the App's Keychain identity and unlock state." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The host cannot access the MCP credential. Check the App's Keychain identity and unlock state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"宿主无法访问 MCP 凭据。请检查应用的钥匙串身份和解锁状态。"}}}},
    "The MCP credential is missing. Save it through the host before connecting." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The MCP credential is missing. Save it through the host before connecting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缺少 MCP 凭据。请先通过宿主保存，再连接。"}}}},
    "The MCP bearer token must be nonempty printable ASCII without whitespace, at most 16 KiB." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The MCP bearer token must be nonempty printable ASCII without whitespace, at most 16 KiB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP Bearer 令牌必须为不含空白的非空可打印 ASCII，且不超过 16 KiB。"}}}},
    "Project" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Project" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "项目" } }
    } },
    "Check connection" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check connection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查连接"}}}},
    "Choose a project" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a project"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择项目"}}}},
    "Register a project before checking a connection." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Register a project before checking a connection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先注册项目，再检查连接。"}}}},
    "Server version" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Server version"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器版本"}}}},
    "Connection checks are unavailable in this build." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection checks are unavailable in this build."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本暂不支持连接检查。"}}}},
    "Checks this MCP’s configuration, credentials and process records. Connection and catalog checks are unavailable in this build." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checks this MCP’s configuration, credentials and process records. Connection and catalog checks are unavailable in this build."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查此 MCP 的配置、凭据和进程记录。此版本暂不支持连接和工具目录检查。"}}}},
    "Not verified: tool execution, remote profile permissions, system permissions and persistent host services." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not verified: tool execution, remote profile permissions, system permissions and persistent host services."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未验证：工具执行、远程配置权限、系统权限及持久化宿主服务。"}}}},
    "The registration is disabled; no connection was started." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The registration is disabled; no connection was started."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此注册已禁用，未启动连接。"}}}},
    "The selected MCP initialized and returned its tool catalog. Tool execution and production permissions were not checked." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected MCP initialized and returned its tool catalog. Tool execution and production permissions were not checked."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 MCP 已初始化并返回工具目录。尚未检查工具执行和生产权限。"}}}},
    "The selected MCP did not complete connection and catalog discovery. Check the launch configuration, endpoint authentication and system permissions." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected MCP did not complete connection and catalog discovery. Check the launch configuration, endpoint authentication and system permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 MCP 未完成连接和目录发现。请检查启动配置、端点认证及系统权限。"}}}},
    "Outstanding calls may have an unknown outcome. Reconnect and inspect before retrying." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Outstanding calls may have an unknown outcome. Reconnect and inspect before retrying." } },
