    "The permissions changed while you were editing. Review them and try again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The permissions changed while you were editing. Review them and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "权限在你编辑时发生了变化。请检查后重试。"}}}},
    "Full Access Allowed" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Full Access Allowed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "允许完全访问"}}}},
    "Full Access for This Session" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Full Access for This Session"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本次会话完全访问"}}}},
    "Each connection needs approval on this Mac before programs can run without the sandbox." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Each connection needs approval on this Mac before programs can run without the sandbox."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "每个连接都需要在这台 Mac 上获得批准，程序才能在沙盒外运行。"}}}},
    "Always applies to every connection that uses “%@”." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Always applies to every connection that uses “%@”."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "“始终允许”适用于使用“%@”的每个连接。"}}}},
