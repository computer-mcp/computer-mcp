    "Install the signed embedded bridge before registering a local MCP client." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install the signed embedded bridge before registering a local MCP client." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注册本地 MCP 客户端前，请先安装已签名的内嵌桥接 CLI。" } } } },
