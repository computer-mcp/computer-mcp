    "The profile for this sign-in changed. Review it and approve again." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The profile for this sign-in changed. Review it and approve again."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此登录请求的配置方案已变化，请重新检查后再批准。"}}}},
    "Expires %@" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Expires %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@过期"}}}},
    "Sign-in requests" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Sign-in requests"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "登录请求"}}}},
    "Approve only if the code matches the one shown in the browser where you are signing in." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Approve only if the code matches the one shown in the browser where you are signing in."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅当此代码与您正在登录的浏览器页面上显示的代码一致时才批准。"}}}},
    "Returns to" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Returns to"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "返回至"}}}},
    "Approve" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Approve"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "批准"}}}},
    "No profile allows Cloudflare tunnel connections. Allow them in a profile to approve this request." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No profile allows Cloudflare tunnel connections. Allow them in a profile to approve this request."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有配置方案允许 Cloudflare 隧道连接。请先在配置方案中允许此类连接，再批准该请求。"}}}},
    "Signed-in remote clients" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Signed-in remote clients"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已登录的远程客户端"}}}},
    "Revoking ends a client's sign-in immediately. It must ask for your approval again to reconnect." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Revoking ends a client's sign-in immediately. It must ask for your approval again to reconnect."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "撤销会立即结束该客户端的登录，它需要再次获得您的批准才能重新连接。"}}}},
    "Last used %@" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Last used %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最近使用：%@"}}}},
    "Sign-in requests waiting: %@" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Sign-in requests waiting: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "等待批准的登录请求：%@"}}}},
    "Allow sign-in with OAuth" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allow sign-in with OAuth"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许通过 OAuth 登录"}}}},
    "Allowed client hosts" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allowed client hosts"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许的客户端主机"}}}},
    "Sign-in for clients such as claude.ai" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Sign-in for clients such as claude.ai"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "供 claude.ai 等客户端登录"}}}},
    "Clients that cannot send a custom header, such as claude.ai, sign in with OAuth. You approve each new client in Client access by matching the code shown on its browser page. Separate client hosts with commas." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clients that cannot send a custom header, such as claude.ai, sign in with OAuth. You approve each new client in Client access by matching the code shown on its browser page. Separate client hosts with commas."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法发送自定义请求头的客户端（例如 claude.ai）通过 OAuth 登录。您需要在“客户端权限”中核对其浏览器页面显示的代码，逐个批准新客户端。多个客户端主机用逗号分隔。"}}}},
    "Result unknown — refresh to check" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Result unknown — refresh to check"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "结果未知，请刷新确认"}}}},
    "Not installed, or its command didn't respond." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Not installed, or its command didn't respond."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未安装，或其命令没有响应。"}}}},
    "%@ isn't available: it isn't installed, or its command didn't respond." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ isn't available: it isn't installed, or its command didn't respond."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%@ 不可用：未安装，或其命令没有响应。"}}}},
    "Computer MCP couldn't confirm whether %@ finished %@. It last showed: %@. Check its settings, then refresh before trying again." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Computer MCP couldn't confirm whether %@ finished %@. It last showed: %@. Check its settings, then refresh before trying again."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Computer MCP 无法确认 %@ 是否完成了%@。最后显示的状态：%@。请检查其设置并刷新后再重试。"}}}},
    "The previous entry was restored." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The previous entry was restored."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已还原原来的条目。"}}}},
    "The previous entry couldn't be restored. Check %@'s settings." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The previous entry couldn't be restored. Check %@'s settings."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法还原原来的条目，请检查 %@ 的设置。"}}}},
