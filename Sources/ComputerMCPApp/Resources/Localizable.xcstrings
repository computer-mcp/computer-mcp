    "Add the hostname and named-tunnel token. Computer MCP will create an access token for the protected loopback origin when requested." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add the hostname and named-tunnel token. Computer MCP will create an access token for the protected loopback origin when requested." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加主机名和命名隧道令牌。需要时，Computer MCP 会为受保护的本地回环源创建访问令牌。" } } } },
    "Add the tunnel ID, tunnel-client profile, gateway profile, and OpenAI API key. The API key is stored in Keychain." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add the tunnel ID, tunnel-client profile, gateway profile, and OpenAI API key. The API key is stored in Keychain." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加隧道 ID、tunnel-client 配置方案、网关配置方案和 OpenAI API 密钥。API 密钥会存储在钥匙串中。" } } } },
    "After the gateway and named tunnel are Ready, connect the intended public MCP consumer using the one-time Computer MCP Access Token, then invoke one tool." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After the gateway and named tunnel are Ready, connect the intended public MCP consumer using the one-time Computer MCP Access Token, then invoke one tool." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关和命名隧道就绪后，使用一次性 Computer MCP 访问令牌连接目标公网 MCP 消费者，然后调用一个工具。" } } } },
    "After the gateway and tunnel are Ready, open ChatGPT, create or update the Connector with the tunnel endpoint, then invoke one Computer MCP tool in a new chat." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After the gateway and tunnel are Ready, open ChatGPT, create or update the Connector with the tunnel endpoint, then invoke one Computer MCP tool in a new chat." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关和隧道就绪后，打开 ChatGPT，使用隧道端点创建或更新连接器，然后在新对话中调用一个 Computer MCP 工具。" } } } },
    "Changes are validated, versioned, and activated atomically." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes are validated, versioned, and activated atomically." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更改会经过验证、版本化，并以原子方式激活。" } } } },
    "ChatGPT Observe" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT Observe" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT 观察" } } } },
    "ChatGPT Operate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT Operate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT 操作" } } } },
    "Checked %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checked %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查于 %@" } } } },
    "Cloudflare Access service tokens belong to consumers and are never stored here." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Access service tokens belong to consumers and are never stored here." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Access 服务令牌属于消费者，绝不会存储在这里。" } } } },
    "Cloudflare Observe" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Observe" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare 观察" } } } },
