    "Each row is one exact argument. No rows means no arguments. Do not enter secrets." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each row is one exact argument. No rows means no arguments. Do not enter secrets."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每行原样传入一个参数。没有行表示不传参数。请勿填写密钥。"}}}},
    "Uses the package's startup arguments." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the package's startup arguments."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用插件包的默认启动参数。"}}}},
    "Host binding" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host binding"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"宿主绑定"}}}},
