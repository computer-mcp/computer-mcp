    "The change couldn't be made." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The change couldn't be made."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法完成更改。"}}}},
