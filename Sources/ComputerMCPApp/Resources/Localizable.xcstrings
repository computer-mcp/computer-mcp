    "This source limits everything it could limit until it can be read." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This source limits everything it could limit until it can be read."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在恢复读取前，此来源会阻止其管控范围内的所有访问。"}}}},
