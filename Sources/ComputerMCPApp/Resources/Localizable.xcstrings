          }
        }
      }
    },
    "storage.dialog.reclaim.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs storage reclamation for logically released records and reports measured reclaimed space after completion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对已逻辑释放的记录执行存储空间回收，并在完成后报告实测回收的空间大小。"
          }
        }
      }
    },
