    "Executable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Executable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可执行文件"}}}},
    "Runtime version" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime version"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"运行时版本"}}}},
    "Binary compatibility" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Binary compatibility"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"二进制兼容性"}}}},
