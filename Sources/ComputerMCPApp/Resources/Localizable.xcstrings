    "Release tag (blank for latest stable)" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Release tag (blank for latest stable)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布标签（留空使用最新稳定版）"}}}},
    "Load release" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Load release"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加载发布版本"}}}},
    "Loading release archives" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loading release archives"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在加载发布归档包"}}}},
    "Prerelease" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prerelease"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预发布版本"}}}},
    "Some release archives lack a valid size or SHA-256 and cannot be installed." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some release archives lack a valid size or SHA-256 and cannot be installed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分发布归档包缺少有效的大小或 SHA-256，无法安装。"}}}},
    "No installable archives on this release page." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No installable archives on this release page."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本发布页没有可安装的归档包。"}}}},
    "Asset page %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Asset page %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档页 %@"}}}},
    "Choose an archive for your Mac. The App checks compatibility and source again before installation. Publisher provenance is not a signature." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an archive for your Mac. The App checks compatibility and source again before installation. Publisher provenance is not a signature."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择适合此 Mac 的归档包。安装前会重新检查兼容性和来源；发布者来源证明不等于签名。"}}}},
    "New plugins start disabled. Updates keep host settings and earlier versions. External dependencies are not installed." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"New plugins start disabled. Updates keep host settings and earlier versions. External dependencies are not installed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新插件默认停用。更新会保留宿主设置和先前版本，不会安装外部依赖。"}}}},
    "Plugin settings changed. Close and reopen this window before installing." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin settings changed. Close and reopen this window before installing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件设置已变更。请关闭并重新打开此窗口后再安装。"}}}},
    "Downloading, checking and installing…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Downloading, checking and installing…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在下载、检查并安装…"}}}},
    "Download and install" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Download and install"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载并安装"}}}},
