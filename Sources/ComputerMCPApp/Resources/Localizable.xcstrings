    "Drag into the app list" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag into the app list" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖入应用列表" } } } },
    "Drag Computer MCP.app into the app list" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag Computer MCP.app into the app list" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将 Computer MCP.app 拖入应用列表" } } } },
    "Drag this app into the Screen & System Audio Recording list, then turn it on." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag this app into the Screen & System Audio Recording list, then turn it on." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将此应用拖入“屏幕与系统音频录制”列表，然后将其开启。" } } } },
    "Turn on Computer MCP under Accessibility." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on Computer MCP under Accessibility." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在“辅助功能”中开启 Computer MCP。" } } } },
    "Turn on Computer MCP under Screen & System Audio Recording." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on Computer MCP under Screen & System Audio Recording." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在“屏幕与系统音频录制”中开启 Computer MCP。" } } } },
    "Turn on Computer MCP for %@." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on Computer MCP for %@." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为 Computer MCP 开启%@权限。" } } } },
    "Install the App-owned CLI" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install the App-owned CLI" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装由应用管理的 CLI" } } } },
    "Install the signed embedded bridge before registering a local MCP client." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install the signed embedded bridge before registering a local MCP client." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注册本地 MCP 客户端前，请先安装已签名的内嵌桥接 CLI。" } } } },
    "Install" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装" } } } },
    "%@ B" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ B" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ B" } } } },
    "%@ retained revision(s)" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ retained revision(s)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留了 %@ 个修订版本" } } } },
    "%@ tools" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ tools" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 个工具" } } } },
    "Activate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Activate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "激活" } } } },
    "Activate %@?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Activate %@?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "激活“%@”？" } } } },
    "Add the hostname and named-tunnel token. Computer MCP will create an access token for the protected loopback origin when requested." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add the hostname and named-tunnel token. Computer MCP will create an access token for the protected loopback origin when requested." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加主机名和命名隧道令牌。需要时，Computer MCP 会为受保护的本地回环源创建访问令牌。" } } } },
    "Add the tunnel ID, tunnel-client profile, gateway profile, and OpenAI API key. The API key is stored in Keychain." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add the tunnel ID, tunnel-client profile, gateway profile, and OpenAI API key. The API key is stored in Keychain." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加隧道 ID、tunnel-client 配置方案、网关配置方案和 OpenAI API 密钥。API 密钥会存储在钥匙串中。" } } } },
    "After the gateway and named tunnel are Ready, connect the intended public MCP consumer using the one-time Computer MCP Access Token, then invoke one tool." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After the gateway and named tunnel are Ready, connect the intended public MCP consumer using the one-time Computer MCP Access Token, then invoke one tool." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关和命名隧道就绪后，使用一次性 Computer MCP 访问令牌连接目标公网 MCP 消费者，然后调用一个工具。" } } } },
    "After the gateway and tunnel are Ready, open ChatGPT, create or update the Connector with the tunnel endpoint, then invoke one Computer MCP tool in a new chat." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After the gateway and tunnel are Ready, open ChatGPT, create or update the Connector with the tunnel endpoint, then invoke one Computer MCP tool in a new chat." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关和隧道就绪后，打开 ChatGPT，使用隧道端点创建或更新连接器，然后在新对话中调用一个 Computer MCP 工具。" } } } },
    "Changes are validated, versioned, and activated atomically." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes are validated, versioned, and activated atomically." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更改会经过验证、版本化，并以原子方式激活。" } } } },
    "ChatGPT Observe" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT Observe" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT 观察" } } } },
    "ChatGPT Operate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT Operate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "ChatGPT 操作" } } } },
    "Checked %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checked %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查于 %@" } } } },
    "Cloudflare Access service tokens belong to consumers and are never stored here." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Access service tokens belong to consumers and are never stored here." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Access 服务令牌属于消费者，绝不会存储在这里。" } } } },
    "Cloudflare Observe" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Observe" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare 观察" } } } },
    "Cloudflare Operate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Operate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare 操作" } } } },
    "Cloudflare Tunnel Logs" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Tunnel Logs" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare 隧道日志" } } } },
    "Computer MCP Access Token created" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP Access Token created" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已创建 Computer MCP 访问令牌" } } } },
    "Computer MCP: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP：%@" } } } },
    "Connected %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接于 %@" } } } },
    "Copy this once into the external consumer. Computer MCP stores it only in Keychain." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy this once into the external consumer. Computer MCP stores it only in Keychain." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请一次性复制到外部消费者。Computer MCP 只会将它存储在钥匙串中。" } } } },
    "Delete" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "Delete %@?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete %@?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除“%@”？" } } } },
    "Enable Full Shell" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Full Shell" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用完整命令行环境" } } } },
    "Enable Full Shell?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Full Shell?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用完整命令行环境？" } } } },
    "Full Shell gives authorized callers the current macOS user's effective file, process, network, and credential access. Workspace grants are not a containment boundary while it is enabled." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Full Shell gives authorized callers the current macOS user's effective file, process, network, and credential access. Workspace grants are not a containment boundary while it is enabled." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完整命令行环境会让获准调用者获得当前 macOS 用户的实际文件、进程、网络和凭据访问能力。启用后，工作区授权不构成隔离边界。" } } } },
    "Gateway Manifest" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Gateway Manifest" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关清单" } } } },
    "Input %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Input %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入摘要 %@" } } } },
    "Leave blank to follow the macOS HTTPS or HTTP proxy. Credentials are not allowed." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave blank to follow the macOS HTTPS or HTTP proxy. Credentials are not allowed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空以跟随 macOS 的 HTTPS 或 HTTP 代理。不允许包含凭据。" } } } },
    "Leave blank to use the configured provider or PATH." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave blank to use the configured provider or PATH." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空以使用已配置的提供方或 PATH。" } } } },
    "Leave the API key blank to keep the existing Keychain value." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave the API key blank to keep the existing Keychain value." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API 密钥留空即可保留钥匙串中的现有值。" } } } },
    "Loopback origin 127.0.0.1:%@ · metrics 127.0.0.1:%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loopback origin 127.0.0.1:%@ · metrics 127.0.0.1:%@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地回环源 127.0.0.1:%@ · 指标 127.0.0.1:%@" } } } },
    "No API keys, tunnel tokens, or TOML paths are included." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No API keys, tunnel tokens, or TOML paths are included." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其中不包含 API 密钥、隧道令牌或 TOML 路径。" } } } },
    "No diagnostic checks were returned." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No diagnostic checks were returned." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未返回诊断检查结果。" } } } },
    "OpenAI" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OpenAI" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OpenAI" } } } },
    "Optional" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选" } } } },
    "Reconnect attempt %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnect attempt %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %@ 次重连" } } } },
    "Register Computer MCP with Codex?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Register Computer MCP with Codex?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将 Computer MCP 注册到 Codex？" } } } },
    "Remotely managed named tunnels only. The App owns the access-token-protected loopback origin." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remotely managed named tunnels only. The App owns the access-token-protected loopback origin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅支持远程管理的命名隧道。应用管理由访问令牌保护的本地回环源。" } } } },
    "Remove" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除" } } } },
    "Remove %@?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove %@?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除“%@”？" } } } },
    "Request %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Request %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请求 %@" } } } },
    "Resolved %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resolved %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已解析 %@" } } } },
    "Review the exact command before Computer MCP changes your Codex MCP registration." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review the exact command before Computer MCP changes your Codex MCP registration." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Computer MCP 更改 Codex MCP 注册前，请检查准确命令。" } } } },
    "Revision %@ will be validated and activated atomically. The running gateway will restart." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Revision %@ will be validated and activated atomically. The running gateway will restart." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "修订版本 %@ 将经过验证并以原子方式激活。正在运行的网关会重启。" } } } },
    "Roll Back" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Roll Back" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "回滚" } } } },
    "Roll back configuration?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Roll back configuration?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "回滚配置？" } } } },
    "The App owns the gateway process; tunnel-client connects through its local bridge." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The App owns the gateway process; tunnel-client connects through its local bridge." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用管理网关进程；tunnel-client 通过本地桥接连接。" } } } },
    "The Codex consumer registration uses the App-owned bridge. Internal Codex providers are configured separately under Providers." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Codex consumer registration uses the App-owned bridge. Internal Codex providers are configured separately under Providers." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Codex 消费者注册使用由应用管理的桥接。内部 Codex 提供方需要在“提供方”中单独配置。" } } } },
    "The journey becomes Verified only when the audit event matches this tunnel, profile, caller identity, and current start time." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The journey becomes Verified only when the audit event matches this tunnel, profile, caller identity, and current start time." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅当审计事件与此隧道、配置方案、调用方身份及本次启动时间匹配时，此路径才会变为“已验证”。" } } } },
    "The local Tunnel profile and its Keychain API key will be removed. The OpenAI Tunnel registration is not deleted." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The local Tunnel profile and its Keychain API key will be removed. The OpenAI Tunnel registration is not deleted." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地隧道配置方案及其钥匙串 API 密钥将被移除。OpenAI 隧道注册不会被删除。" } } } },
    "The local named-tunnel profile and its Keychain secrets will be removed. The Cloudflare account tunnel remains user-owned." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The local named-tunnel profile and its Keychain secrets will be removed. The Cloudflare account tunnel remains user-owned." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地命名隧道配置方案及其钥匙串凭据将被移除。Cloudflare 账号中的隧道仍归用户所有。" } } } },
    "This profile expands the capabilities available to its configured callers. The change is local and takes effect immediately." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This profile expands the capabilities available to its configured callers. The change is local and takes effect immediately." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此配置方案会扩大其已配置调用方可用的能力。更改只在本地生效，并会立即应用。" } } } },
    "This removes the local workspace grant. It does not delete the folder or its contents." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This removes the local workspace grant. It does not delete the folder or its contents." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这会移除本地工作区授权，但不会删除文件夹或其中内容。" } } } },
    "Tunnel Logs" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tunnel Logs" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隧道日志" } } } },
    "Version %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本 %@" } } } },
    "You can retry any step without recreating the connection. Secrets remain in Keychain and are never included in diagnostics." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can retry any step without recreating the connection. Secrets remain in Keychain and are never included in diagnostics." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无需重新创建连接即可重试任意步骤。密钥始终保留在钥匙串中，绝不会出现在诊断信息里。" } } } },
    "cloudflared PID %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "cloudflared PID %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "cloudflared PID %@" } } } },
    "https://%@/mcp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "https://%@/mcp" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "https://%@/mcp" } } } },
    "Computer MCP.app is not running or its owner-only control socket is unavailable." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP.app is not running or its owner-only control socket is unavailable." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP.app 未运行，或其仅限当前用户的控制套接字不可用。" } } } },
    "Computer MCP App is unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP App is unavailable" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Computer MCP 应用不可用" } } } },
