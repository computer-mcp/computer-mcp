    "Search public repositories published by computer-mcp on GitHub." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search public repositories published by computer-mcp on GitHub."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索 GitHub 上 computer-mcp 组织发布的公开仓库。"}}}},
    "Search names, descriptions, or repositories" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search names, descriptions, or repositories"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索名称、描述或仓库"}}}},
    "Contribution" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Contribution"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"集成类型"}}}},
    "All contributions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All contributions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全部类型"}}}},
    "Previous results are shown below; the latest request failed." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Previous results are shown below; the latest request failed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近一次请求失败，下面保留此前的结果。"}}}},
    "Searching GitHub" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Searching GitHub"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在搜索 GitHub"}}}},
    "Cancel search" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消搜索"}}}},
    "Discovery does not install packages or grant access." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discovery does not install packages or grant access."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索不会安装插件包或授予权限。"}}}},
    "Repository page %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repository page %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仓库第 %@ 页"}}}},
    "Cached" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cached"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存结果"}}}},
    "Fetched from GitHub" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fetched from GitHub"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从 GitHub 获取"}}}},
    "Results for" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Results for"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索条件"}}}},
    "No matching plugins on this repository page." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No matching plugins on this repository page."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本页仓库中没有匹配的插件。"}}}},
    "Repositories with discovery issues" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repositories with discovery issues"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法正常读取的仓库"}}}},
    "Previous page" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Previous page"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上一页"}}}},
    "Next page" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Next page"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一页"}}}},
    "Refresh page" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh page"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新本页"}}}},
    "Each page checks up to 10 repositories. Continue to the next page even if this page has no matches." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each page checks up to 10 repositories. Continue to the next page even if this page has no matches."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每页检查最多 10 个仓库。本页没有匹配项时，仍可继续查看下一页。"}}}},
    "Official source identifies the publisher, not a verified artifact or signature. Discovery does not install packages or grant access." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Official source identifies the publisher, not a verified artifact or signature. Discovery does not install packages or grant access."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方来源用于确认发布者，不代表安装包或签名已通过验证。搜索不会安装插件包或授予权限。"}}}},
    "Source details" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source details"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源详情"}}}},
    "Repository ID" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repository ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仓库标识"}}}},
    "Publisher ID" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Publisher ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布者标识"}}}},
    "Commit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Commit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提交"}}}},
    "Manifest SHA-256" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manifest SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清单 SHA-256"}}}},
    "Open pinned declaration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open pinned declaration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看固定提交的清单"}}}},
    "GitHub request failed with HTTP %@." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"GitHub request failed with HTTP %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 请求失败，HTTP 状态码为 %@。"}}}},
    "Invalid plugin request. Check repository identity, tag, query length and page bounds." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid plugin request. Check repository identity, tag, query length and page bounds."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件请求无效。请检查仓库标识、发布标签、搜索长度及页码范围。"}}}},
    "Another official plugin search is in progress. Try again when it finishes." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Another official plugin search is in progress. Try again when it finishes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另一个官方插件搜索正在进行，请稍后重试。"}}}},
    "GitHub returned an invalid plugin catalog response." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"GitHub returned an invalid plugin catalog response."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 返回的插件目录数据无效。"}}}},
    "The repository's plugin declaration is invalid." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The repository's plugin declaration is invalid."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仓库中的插件清单无效。"}}}},
    "The plugin's GitHub publisher, repository or release does not match the selected source." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin's GitHub publisher, repository or release does not match the selected source."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件的 GitHub 发布者、仓库或发布版本与所选来源不一致。"}}}},
    "The plugin catalog response exceeded its size limit." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin catalog response exceeded its size limit."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件目录响应超过大小限制。"}}}},
    "The plugin request was refused because its destination is not allowed." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin request was refused because its destination is not allowed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件请求的目标地址不在允许范围内，已拒绝访问。"}}}},
    "GitHub has limited plugin requests. Wait before trying again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"GitHub has limited plugin requests. Wait before trying again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 已限制插件请求，请稍后重试。"}}}},
    "GitHub plugin request timed out. Check the connection and try again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"GitHub plugin request timed out. Check the connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 插件请求超时，请检查网络连接后重试。"}}}},
    "GitHub is unavailable. Check the connection and try again." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"GitHub is unavailable. Check the connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接 GitHub，请检查网络连接后重试。"}}}},
