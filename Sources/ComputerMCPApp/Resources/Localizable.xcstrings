    "Only this installation's owned files will be removed. Host settings, other versions and external dependencies will be kept." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only this installation's owned files will be removed. Host settings, other versions and external dependencies will be kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只移除此安装记录所属的文件，保留宿主设置、其他版本和外部依赖。"}}}},
    "Choose a ZIP, TAR or gzip package and enter its expected identity and SHA-256 from a trusted source." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a ZIP, TAR or gzip package and enter its expected identity and SHA-256 from a trusted source."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 ZIP、TAR 或 gzip 包，并填入从可信来源获得的预期标识和 SHA-256。"}}}},
    "A matching digest verifies the archive bytes, not an official publisher. New plugins start disabled. Updates keep host settings and earlier versions." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A matching digest verifies the archive bytes, not an official publisher. New plugins start disabled. Updates keep host settings and earlier versions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"摘要匹配只能验证归档文件内容，不能证明官方发布者身份。新插件默认停用；更新保留宿主设置及先前版本。"}}}},
    "External dependencies are not installed. Use an earlier source in the plugin details to roll back." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"External dependencies are not installed. Use an earlier source in the plugin details to roll back."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不会安装外部依赖。如需回滚，请在插件详情中选择先前版本。"}}}},
    "Plugin file recovery could not finish. Check the App-owned storage and retry recovery." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin file recovery could not finish. Check the App-owned storage and retry recovery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件文件恢复未能完成。请检查应用管理的存储目录后重试恢复。"}}}},
    "A plugin installation or recovery is still running. Retry when it finishes." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A plugin installation or recovery is still running. Retry when it finishes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件安装或恢复仍在运行，请等待其结束后重试。"}}}},
    "The App's embedded plugin archive worker is unavailable. Check the App installation; no PATH executable was used." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App's embedded plugin archive worker is unavailable. Check the App installation; no PATH executable was used."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用内置的归档检查程序不可用。请检查应用安装；未使用 PATH 中的其他程序。"}}}},
    "Plugin file recovery is incomplete. Missing, unverified or still-referenced directories require attention." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin file recovery is incomplete. Missing, unverified or still-referenced directories require attention."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件文件恢复尚未完成。请检查缺失、无法验证或仍被引用的目录。"}}}},
    "GitHub requested authentication. Public plugin requests do not use host credentials." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"GitHub requested authentication. Public plugin requests do not use host credentials."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 要求身份验证。公开插件请求不会使用宿主凭据。"}}}},
    "Some repositories could not be checked. Results may be incomplete." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some repositories could not be checked. Results may be incomplete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分仓库无法检查，搜索结果可能不完整。"}}}},
