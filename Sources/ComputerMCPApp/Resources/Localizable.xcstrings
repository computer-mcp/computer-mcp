    "Review the change before applying it." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Review the change before applying it."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请先检查更改再应用。"}}}},
