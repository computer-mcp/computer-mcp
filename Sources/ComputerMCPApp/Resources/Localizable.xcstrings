    "System permissions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System permissions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统权限"}}}},
    "Selected package and declaration identity were validated." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected package and declaration identity were validated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已验证所选插件包及清单身份。"}}}},
    "The declaration permits this host version and architecture." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The declaration permits this host version and architecture."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清单允许当前宿主版本与架构。"}}}},
    "The declaration excludes this host version or architecture. Select a compatible package." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The declaration excludes this host version or architecture. Select a compatible package."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清单不支持当前宿主版本或架构，请选择兼容的插件包。"}}}},
    "No executable was resolved for this dependency. Follow its setup instructions or set a host binding." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No executable was resolved for this dependency. Follow its setup instructions or set a host binding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能为此依赖找到可执行文件，请按依赖说明配置，或在宿主中绑定路径。"}}}},
    "The declared Skills directory passed package path validation. Skill contents and scripts were not executed." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The declared Skills directory passed package path validation. Skill contents and scripts were not executed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"声明的技能目录已通过插件包路径验证，未执行技能内容或脚本。"}}}},
    "No selected or bundled source is available. Select an installed source or register a package." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No selected or bundled source is available. Select an installed source or register a package."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有可用的所选来源或内置来源，请选择已安装的来源或注册插件包。"}}}},
    "File and interpreter checks passed; actual startup has not been verified." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"File and interpreter checks passed; actual startup has not been verified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件与解释器检查通过，尚未验证实际启动。"}}}},
    "The executable was not found in the configured location or launch search path." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The executable was not found in the configured location or launch search path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在配置位置或启动搜索路径中未找到可执行文件。"}}}},
    "The executable path is empty, too long or contains NUL." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The executable path is empty, too long or contains NUL."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可执行文件路径为空、过长或含有 NUL 字符。"}}}},
    "The executable path does not identify a regular file." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The executable path does not identify a regular file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可执行文件路径未指向普通文件。"}}}},
    "The current user cannot execute this file." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current user cannot execute this file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前用户无法执行此文件。"}}}},
    "The executable header could not be safely read; check access and retry." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The executable header could not be safely read; check access and retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法安全读取可执行文件头，请检查访问权限后重试。"}}}},
    "The script has an invalid interpreter declaration for macOS." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The script has an invalid interpreter declaration for macOS."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"脚本的解释器声明在 macOS 上无效。"}}}},
    "A script interpreter is unavailable in the launch environment. Check its path and runtime installation." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A script interpreter is unavailable in the launch environment. Check its path and runtime installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启动环境中缺少可用的脚本解释器，请检查其路径与运行时安装状态。"}}}},
    "This interpreter invocation needs further verification; no script or probe was executed." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This interpreter invocation needs further verification; no script or probe was executed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此解释器调用仍需进一步验证，本次文件检查未执行脚本或探测程序。"}}}},
    "Close" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Close"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}}}},
    "The operation was cancelled. Check the selected source before retrying." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The operation was cancelled. Check the selected source before retrying."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作已取消。重试前请先检查当前选中的来源。"}}}},
    "Cancelling and checking the result…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelling and checking the result…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在取消并核对结果…"}}}},
    "Cancel installation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel installation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消安装"}}}},
