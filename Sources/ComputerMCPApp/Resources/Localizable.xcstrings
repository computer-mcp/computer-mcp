    "“%1$@” would like to connect to “%2$@” from “%3$@”." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "“%1$@” would like to connect to “%2$@” from “%3$@”."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "“%1$@”想要连接“%2$@”（来自“%3$@”）。"}}}},
    "Allowing adds the host to the project's network access in the sandbox." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allowing adds the host to the project's network access in the sandbox."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "允许后，这个主机会加入该项目在沙盒中的网络访问。"}}}},
